<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sukoon_expense_list" model="ir.ui.view">
        <field name="name">sukoon.expense.list</field>
        <field name="model">sukoon.expense</field>
        <field name="arch" type="xml">
            <list string="Expenses">
                <field name="date"/>
                <field name="name"/>
                <field name="property_id"/>
                <field name="owner_id" optional="hide"/>
                <field name="category" widget="badge"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_sukoon_expense_form" model="ir.ui.view">
        <field name="name">sukoon.expense.form</field>
        <field name="model">sukoon.expense</field>
        <field name="arch" type="xml">
            <form string="Expense">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Plumber - kitchen sink"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id" options="{'no_create': True}"/>
                            <field name="owner_id" invisible="not owner_id"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sukoon_expense_search" model="ir.ui.view">
        <field name="name">sukoon.expense.search</field>
        <field name="model">sukoon.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="property_id"/>
                <field name="owner_id"/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sukoon_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">sukoon.expense</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No expenses logged</p>
            <p>Track maintenance, supplies and fees per property.</p>
        </field>
    </record>
</odoo>
