<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sukoon_task_list" model="ir.ui.view">
        <field name="name">sukoon.task.list</field>
        <field name="model">sukoon.task</field>
        <field name="arch" type="xml">
            <list string="Tasks" decoration-muted="state == 'done'"
                  decoration-danger="state != 'done' and due_date &lt; current_date">
                <field name="name"/>
                <field name="property_id"/>
                <field name="task_type"/>
                <field name="due_date"/>
                <field name="assignee"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-info="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_sukoon_task_kanban" model="ir.ui.view">
        <field name="name">sukoon.task.kanban</field>
        <field name="model">sukoon.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="0">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="property_id" class="text-muted"/>
                        <div class="d-flex justify-content-between mt-1">
                            <field name="task_type" widget="badge"/>
                            <field name="due_date"/>
                        </div>
                        <field name="assignee" class="small"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sukoon_task_form" model="ir.ui.view">
        <field name="name">sukoon.task.form</field>
        <field name="model">sukoon.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Turnover clean before 3pm check-in"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id" options="{'no_create': True}"/>
                            <field name="task_type"/>
                            <field name="reservation_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="assignee" placeholder="e.g. Maria G."/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sukoon_task_search" model="ir.ui.view">
        <field name="name">sukoon.task.search</field>
        <field name="model">sukoon.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="property_id"/>
                <field name="assignee"/>
                <filter name="open" string="Open" domain="[('state', '!=', 'done')]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('state', '!=', 'done'), ('due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="cleaning" string="Cleaning" domain="[('task_type', '=', 'cleaning')]"/>
                <filter name="maintenance" string="Maintenance" domain="[('task_type', '=', 'maintenance')]"/>
                <group>
                    <filter name="group_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'task_type'}"/>
                    <filter name="group_assignee" string="Assigned To" context="{'group_by': 'assignee'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sukoon_task" model="ir.actions.act_window">
        <field name="name">Cleaning &amp; Tasks</field>
        <field name="res_model">sukoon.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing here</p>
            <p>Add a cleaning or maintenance task.</p>
        </field>
    </record>
</odoo>
