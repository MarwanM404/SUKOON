<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Owners are res.partner records; these are slimmed-down views used
         only from the Sukoon Owners menu. -->
    <record id="view_sukoon_owner_list" model="ir.ui.view">
        <field name="name">res.partner.sukoon.owner.list</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Owners">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="sukoon_property_count" string="Properties"/>
                <field name="payout_notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sukoon_owner_form" model="ir.ui.view">
        <field name="name">res.partner.sukoon.owner.form</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Owner">
                <header>
                    <button name="action_open_owner_statement" type="object"
                            string="Owner Statement" class="btn-primary"
                            groups="sukoon_pms.group_sukoon_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sukoon_properties" type="object"
                                class="oe_stat_button" icon="fa-home">
                            <field name="sukoon_property_count" widget="statinfo" string="Properties"/>
                        </button>
                    </div>
                    <field name="is_property_owner" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Owner Name"/>
                        <h1><field name="name" placeholder="e.g. Dana Whitfield" required="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="email" widget="email" placeholder="dana@example.com"/>
                            <field name="phone" widget="phone" placeholder="(555) 010-1234"/>
                        </group>
                        <group>
                            <field name="payout_notes" placeholder="Bank transfer, monthly on the 5th..."/>
                        </group>
                    </group>
                    <separator string="Properties"/>
                    <field name="sukoon_property_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="address"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="nightly_rate"/>
                            <field name="commission_pct" string="Commission %"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sukoon_owner_search" model="ir.ui.view">
        <field name="name">res.partner.sukoon.owner.search</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </search>
        </field>
    </record>

    <record id="action_sukoon_owner" model="ir.actions.act_window">
        <field name="name">Owners</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_property_owner', '=', True)]</field>
        <field name="context">{'default_is_property_owner': True, 'default_is_company': False}</field>
        <field name="search_view_id" ref="view_sukoon_owner_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No owners yet</p>
            <p>Add an owner, then link their properties.</p>
        </field>
    </record>
    <record id="action_sukoon_owner_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_sukoon_owner_list"/>
        <field name="act_window_id" ref="action_sukoon_owner"/>
    </record>
    <record id="action_sukoon_owner_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sukoon_owner_form"/>
        <field name="act_window_id" ref="action_sukoon_owner"/>
    </record>
</odoo>
