<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_sukoon" model="res.groups.privilege">
        <field name="name">Sukoon PMS</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <!-- Staff: run reservations and tasks, log expenses. -->
    <record id="group_sukoon_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Can manage reservations and tasks and log expenses. Can see properties and owners but not change them.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_sukoon"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Managers: everything, including owners, properties and commission. -->
    <record id="group_sukoon_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Full access, including owners, properties, commission and owner statements.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_sukoon"/>
        <field name="implied_ids" eval="[(4, ref('group_sukoon_user')), (4, ref('base.group_partner_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
