<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Hourly and cheap (it only looks at Upcoming / In stay bookings),
             so statuses flip soon after midnight. Runs as the admin user so
             "today" uses the admin's timezone (Preferences > Timezone). -->
        <record id="ir_cron_sukoon_reservation_states" model="ir.cron">
            <field name="name">Sukoon: update reservation statuses from dates</field>
            <field name="model_id" ref="model_sukoon_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_states()</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>
    </data>

    <!-- Catch up on install and on every upgrade. -->
    <function model="sukoon.reservation" name="_cron_update_states"/>
</odoo>
